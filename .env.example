# Cairose local environment. Copy to .env.local.
# The app compiles and the demo storefront/panel work without real keys
# (local seed fallback). Auth and live Convex need the values below.

# --- Convex ---
# From `npx convex dev` (use CONVEX_AGENT_MODE=anonymous for cloud agents).
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud
CONVEX_DEPLOYMENT=

# --- Clerk (Google + email/SMS OTP — enable those in the Clerk dashboard) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/panel

# Convex auth.config.ts reads this on the Convex deployment (not Next.js):
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# Also create a Clerk JWT template named "convex".

# --- Host routing ---
# Path fallback always works: /t/casa-limon
# Subdomain: add to /etc/hosts → 127.0.0.1 casa-limon.cairose.local cairose.local
PLATFORM_ROOT_DOMAIN=cairose.local

# --- Microsoft Clarity (optional; do not block the product cut) ---
# Env var name: NEXT_PUBLIC_CLARITY_ID
# Daniela pastes the real project ID after there is a public URL.
# Leave empty until then. Do not invent an ID.
# Custom event names: TBD (tracking plan later).
NEXT_PUBLIC_CLARITY_ID=
